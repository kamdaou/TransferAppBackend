  "item": [
    {
      "name": "1. Auth",
      "description": "Login and registration endpoints. No auth required.",
      "item": [
        {
          "name": "Super Admin Login",
          "description": "Login as the super admin created from env variables.\ncompanyCode is always __SYSTEM__.\nCopy the token from the response into the collection variable 'token'.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+23500000000\",\n  \"pin\": \"000000\",\n  \"companyCode\": \"__SYSTEM__\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", json.token);",
                  "    console.log(\"Token saved for Super Admin\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
